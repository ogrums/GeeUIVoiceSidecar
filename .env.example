# Copier vers .env et adapter. Les variables vides reprennent les défauts de emo_server.py.
#
# Important : dans un conteneur, 127.0.0.1 est le conteneur lui-même, pas nimbus.
# Utiliser l'IP LAN de l'hôte (ex. http://192.168.2.155:13305/api/v1) ou
# host.docker.internal (voir extra_hosts dans docker-compose.yml).
#
# nanobot écoute souvent uniquement sur 127.0.0.1:8900 (Docker rootless de
# l'utilisateur). Depuis un conteneur en réseau bridge, ce port n'est pas
# joignable. Pour y accéder : lier nanobot à l'IP LAN, ou décommenter
# network_mode: host dans docker-compose.yml.

# --- Écoute du sidecar ---
# Sert aussi à déterminer le port d'écoute (13306 par défaut).
EMO_HOST=http://0.0.0.0:13306

# --- Lemonade (STT / TTS Kokoro / repli chat) ---
LEMONADE_HOST=http://192.168.2.155:13305/api/v1
# Alternative : LEMONADE_HOST=http://host.docker.internal:13305/api/v1
EMO_STT_MODEL=Whisper-Small
# Défaut dans le code : gemma4e-flash-e2b-FLM (repli Lemonade).
# Sur nimbus, le modèle recommandé est plutôt :
EMO_CHAT_MODEL=gemma4-it-e2b-FLM
KOKORO_MODEL=kokoro-v1
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart

# --- Pocket TTS (optionnel, voix française préférée) ---
# Si défini, /v1/audio/speech essaie d'abord Pocket TTS (serveur OpenAI,
# ex. pockettts-openai-server sur 49112), puis Kokoro (Lemonade) en cas
# d'erreur ou de délai dépassé. Les voix Kokoro anglaises (af_, am_, bf_, bm_)
# restent sur Kokoro. Une voix Kokoro française ou inconnue de Pocket devient
# POCKET_TTS_VOICE ; une voix Pocket connue (cosette, javert…) passe telle quelle.
# En mode host : http://127.0.0.1:49112 ; en bridge : http://192.168.2.155:49112
POCKET_TTS_URL=
POCKET_TTS_VOICE=alba
POCKET_TTS_TIMEOUT=20

# --- CosyVoice (optionnel, second hôte TTS) ---
COSYVOICE_HOST=
COSYVOICE_MODEL=cosyvoice2

# --- nanobot (cerveau, optionnel) ---
# Laisser NANOBOT_URL vide pour envoyer le chat directement à Lemonade.
NANOBOT_URL=http://192.168.2.155:8900/v1
NANOBOT_API_KEY=
NANOBOT_SESSION=rux
NANOBOT_FAST=rapide
NANOBOT_HEAVY=lourd
NANOBOT_HEAVY_WORDS=explique,résume,planifie,calcule,compare,écris,traduis,pourquoi,recherche,réfléchis,prépare,apprends
NANOBOT_HEAVY_CHARS=200
NANOBOT_TIMEOUT=120

# --- Qui parle (empreinte vocale, optionnel) ---
# Vide = désactivé. Le fichier est téléchargé dans /models au démarrage s'il manque.
# Tant que personne n'est enregistré (« retiens ma voix, je suis Paul »), rien ne change.
SPEAKER_MODEL=/models/wespeaker_en_voxceleb_resnet34_LM.onnx
SPEAKER_DOWNLOAD=1
SPEAKERS_FILE=/data/speakers.json
# Score cosinus minimal et écart avec la 2e personne. À régler sur les vraies voix.
SPEAKER_THRESHOLD=0.5
SPEAKER_MARGIN=0.05
# Entre DOUBT et THRESHOLD : on garde la dernière personne si elle a parlé il y a < STICKY_S s.
SPEAKER_DOUBT=0.35
SPEAKER_STICKY_S=60
# Phrase plus courte (« oui ») : on garde la dernière personne.
SPEAKER_MIN_S=1.2
SPEAKER_ENROLL_SAMPLES=3
SPEAKER_ENROLL_MIN_S=2.0
# cpu par défaut ; cuda si sherpa-onnx GPU est installé.
SPEAKER_PROVIDER=cpu
SPEAKER_THREADS=1
# lemonade (défaut : rien n'est gardé pour un invité, pas d'outils) ou nanobot (session rux-invite)
SPEAKER_GUEST_ROUTE=lemonade
# Rôle d'une nouvelle voix quand quelqu'un est déjà inscrit (la première est adulte).
# Un adulte connu dit ensuite « Marie est une adulte ». enfant ou adulte.
SPEAKER_NEW_ROLE=enfant
# Balises d'action que l'app exécute selon le rôle (move,volume,light,photo,home ; * = toutes).
ACTIONS_ADULTE=*
ACTIONS_ENFANT=volume,light,photo
ACTIONS_INVITE=volume,light
# Protège GET /v1/speakers, DELETE /v1/speakers/<id> et POST /v1/speakers/<id>/role. Vide = routes fermées.
SIDECAR_ADMIN_KEY=

# --- Émotion audio (emotion2vec ONNX) ---
# L'entrypoint télécharge les fichiers dans /models s'ils manquent, sauf si :
EMO_AUDIO_DOWNLOAD=1
EMO_AUDIO_ONNX=/models/emotion2vec_plus_base.onnx
EMO_AUDIO_HEAD=/models/emotion2vec_head.json
EMO_AUDIO_MODEL=emotion2vec
EMO_AUDIO_CMD=
EMO_AUDIO_LABELS=
EMO_MIN_RMS=0.003
# Vide = choix automatique (CUDA, ROCm, … puis CPU). Ex. : CPUExecutionProvider
EMO_ORT_PROVIDERS=
